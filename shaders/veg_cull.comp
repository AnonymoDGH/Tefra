#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/gpu_types.glsl"
#include "common/vegetation.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform Push {
    FrameBuffer frame; VegInstanceBuffer instances; VegProtoBuffer protos; VegDrawBuffer draws;
    IndexListBuffer visible; DrawCmdBuffer cmds; IndexListBuffer shadow_visible; DrawCmdBuffer shadow_cmds;
    uint count;
} pc;
void emit(DrawCmdBuffer cmds, IndexListBuffer vis, uint d0, uint d1, uint index) {
    uint slot = atomicAdd(cmds.c[d0].instance_count, 1u);
    vis.v[pc.draws.d[d0].visible_base + slot] = index;
    if (d1 != 0xFFFFFFFFu) atomicAdd(cmds.c[d1].instance_count, 1u);
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    Frame f = pc.frame.f;
    VegInstance inst = pc.instances.i[i];
    uint pid = uint(inst.rot_proto.z);
    VegProto p = pc.protos.p[pid];
    float s = inst.pos_scale.w;
    vec3 c = inst.pos_scale.xyz + vec3(0.0, p.bounds.y * s, 0.0) - f.camera_pos.xyz;
    float r = p.bounds.w * s;
    float dist = length(c);
    int lod = dist < p.lod_dist.x ? 0 : ((p.lod_dist.w > 1.5 && dist < p.lod_dist.y) ? 1 : -1);
    if (lod < 0) return;
    uint d0 = lod == 0 ? p.draw00 : p.draw10;
    uint d1 = lod == 0 ? p.draw01 : p.draw11;
    if (p.casts != 0u && dist < p.lod_dist.z) emit(pc.shadow_cmds, pc.shadow_visible, d0, d1, i);
    mat4 m = f.view_proj;
    vec4 r0 = vec4(m[0][0], m[1][0], m[2][0], m[3][0]), r1 = vec4(m[0][1], m[1][1], m[2][1], m[3][1]);
    vec4 r2 = vec4(m[0][2], m[1][2], m[2][2], m[3][2]), r3 = vec4(m[0][3], m[1][3], m[2][3], m[3][3]);
    vec4 planes[5] = vec4[](r3 + r0, r3 - r0, r3 + r1, r3 - r1, r2);
    for (int k = 0; k < 5; ++k) {
        vec4 pl = planes[k] / length(planes[k].xyz);
        if (dot(pl.xyz, c) + pl.w < -r) return;
    }
    emit(pc.cmds, pc.visible, d0, d1, i);
}
