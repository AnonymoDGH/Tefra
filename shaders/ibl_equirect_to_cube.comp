#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/bindless.glsl"
#include "common/cube.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2DArray u_dst;
layout(push_constant) uniform Push { uint src; uint size; float roughness; uint samples; float src_size; } pc;
void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= pc.size || id.y >= pc.size) return;
    // 2x2 supersampling per texel.
    vec3 acc = vec3(0.0);
    for (int j = 0; j < 2; ++j)
        for (int i = 0; i < 2; ++i) {
            vec2 st = (vec2(id.xy) + vec2(0.25 + 0.5 * i, 0.25 + 0.5 * j)) / float(pc.size) * 2.0 - 1.0;
            acc += textureLod(TEX2D(pc.src, SMP_LINEAR_REPEAT), equirect_uv(cube_dir(id.z, st)), 0.0).rgb;
        }
    imageStore(u_dst, ivec3(id), vec4(acc * 0.25, 1.0));
}
