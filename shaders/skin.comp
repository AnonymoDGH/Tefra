#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#include "common/gpu_types.glsl"
// Linear blend skinning of one skinned primitive (spec M3b, ADR-016). Writes the posed vertices in the Vertex layout,
// so the G-buffer and shadow vertex stages draw them unchanged: `dst` with the current palette, `dst_prev` with the
// previous frame's palette (motion vectors). Mirrors skin_vertex_reference() in engine/renderer/src/skin.cpp.

layout(local_size_x = 64) in;

struct SkinAttr {
    uvec4 joints;
    vec4 weights;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer SkinSrcVertices { Vertex v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer SkinAttributes { SkinAttr a[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer SkinPalette { mat4 m[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer SkinDstVertices { Vertex v[]; };

// Field order must match SkinPush in engine/renderer/src/renderer.cpp.
layout(push_constant) uniform Push {
    SkinSrcVertices src;
    SkinAttributes attrs;
    SkinPalette palette;
    SkinPalette palette_prev;
    SkinDstVertices dst;
    SkinDstVertices dst_prev;
    uint count;
    uint pad;
} pc;

uint oct_pack(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return packSnorm2x16(e);
}

// The palette is chosen with a flag rather than passed as a buffer reference: legacy AMD shader compilers (GCN 1.x,
// Vulkan 1.2.170) crash on PhysicalStorageBuffer function parameters.
mat4 palette_matrix(bool prev, uint joint) { return prev ? pc.palette_prev.m[joint] : pc.palette.m[joint]; }

Vertex skin_vertex(bool prev, Vertex v, SkinAttr sa) {
    vec3 bind_n = oct_decode(v.normal);
    vec3 bind_t = oct_decode(v.tangent);
    vec4 bind_p = vec4(v.pos, 1.0);
    vec4 p = vec4(0.0);
    vec3 n = vec3(0.0), t = vec3(0.0);
    float wsum = 0.0;
    for (int k = 0; k < 4; ++k) {
        float w = sa.weights[k];
        if (w <= 0.0) continue;
        mat4 m = palette_matrix(prev, sa.joints[k]);
        p += w * (m * bind_p);
        n += w * (mat3(m) * bind_n);
        t += w * (mat3(m) * bind_t);
        wsum += w;
    }
    Vertex o = v;
    if (wsum > 0.0) {
        o.pos = p.xyz;
        o.normal = oct_pack(length(n) > 1e-12 ? normalize(n) : bind_n);
        o.tangent = oct_pack(length(t) > 1e-12 ? normalize(t) : bind_t);
    }
    return o;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    Vertex v = pc.src.v[i];
    SkinAttr sa = pc.attrs.a[i];
    pc.dst.v[i] = skin_vertex(false, v, sa);
    pc.dst_prev.v[i] = skin_vertex(true, v, sa);
}
