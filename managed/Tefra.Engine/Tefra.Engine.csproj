<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tefra scripting runtime (spec M3, ADR-013). Built by CMake through `dotnet build` and loaded by the native
       host (engine/scripting) with hostfxr. Roslyn is packaged next to it so Play can compile scripts in memory. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Tefra.Engine</AssemblyName>
    <RootNamespace>Tefra</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <UseAppHost>false</UseAppHost>
    <!-- Roslyn and its helpers must sit next to Tefra.Engine.dll: the scripts compile against them at Play. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
