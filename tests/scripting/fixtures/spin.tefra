   "class": "ServerScriptService",
   "props": {},
   "children": [
    {
     "class": "Script",
     "id": 104,
     "props": {
      "Name": "Spawner",
      "Source": "public class Spawner : TefraScript {\n    public override void Start() {\n        for (int i = 0; i < 10; i++) {\n            var part = (Part)Instance.New(\"Part\", Game.Workspace);\n            part.Name = \"Spawned\" + i;\n            part.Position = new Vector3(i * 3f, 0.5f, 0);\n            part.Color = Color3.FromRGB(200, 60, 40);\n            part.Anchored = true;\n        }\n        print(\"spawned\", 10);\n    }\n}\n"
     }
    }
