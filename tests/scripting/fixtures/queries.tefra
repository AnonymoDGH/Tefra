{
 "format": "tefra-place",
 "version": 1,
 "services": [
  {
   "class": "Workspace",
   "props": {
    "FallenPartsDestroyHeight": -200
   },
   "children": [
    {
     "class": "Part",
     "props": {
      "Name": "Floor",
      "Position": [
