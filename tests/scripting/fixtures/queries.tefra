     }
    },
    {
     "class": "Part",
     "props": {
      "Name": "Tilted",
      "Position": [
       -10,
       1,
       0
      ],
      "Size": [
       2,
       2,
       2
      ],
      "Anchored": true,
      "CanCollide": true,
      "Orientation": [
